NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/potli?replicaSet=rs0&directConnection=true
JWT_SECRET=
JWT_EXPIRES_IN=7d
ADMIN_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Must be reachable from your phone. Use your computer LAN IP for physical devices.
PUBLIC_URL=http://localhost:4000
IMAGE_STORAGE=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GOOGLE_CLIENT_IDS=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional FCM: path to YOUR Firebase service account JSON; never commit it.
GOOGLE_APPLICATION_CREDENTIALS=
SHOP_NAME=POTLI
SHOP_ADDRESS=
SUPPORT_EMAIL=
SHIPPING_STANDARD=99
SHIPPING_EXPRESS=199
FREE_SHIPPING_THRESHOLD=2999
RETURN_WINDOW_DAYS=14
